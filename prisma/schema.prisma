generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Customer {
  id                String   @id @default(cuid())
  nome              String
  cpf               String   @unique
  email             String
  telefone          String
  valorConta        Float
  nomeTitular       String
  unidade           String?
  billFileName      String?
  billFileData      String?
  status            String   @default("pending")
  paymentStatus     String   @default("unpaid")
  paidAt            DateTime?
  hubpagueTransactionId String?
  hubpaguePixCode   String?
  hubpaguePixQrCode String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
